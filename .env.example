# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ---
# Docker Compose publishes Postgres on host port 55432 (override with POSTGRES_PORT).
# Using a local PostgreSQL on 5432 instead? Change the port in both URLs below.
DATABASE_URL=postgres://trading:trading@localhost:55432/trading
# Used only by `npm test` (integration tests drop and recreate the public schema!)
TEST_DATABASE_URL=postgres://trading:trading@localhost:55432/trading_test
DATABASE_POOL_MAX=20

# --- Auth ---
# Development-only placeholder. Generate a real one with: openssl rand -hex 32
JWT_SECRET=change-me-dev-only-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

# --- Accounts ---
# Stablecoin (USD) credited to every newly registered user (simulation only)
INITIAL_USER_FUNDING=100000
SEED_USER_EMAIL=alice@example.com
SEED_USER_PASSWORD=password123

# --- Price simulator ---
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=1000
SIMULATOR_SEED=42
# Annualised volatility & drift used by the geometric Brownian motion step
SIMULATOR_VOLATILITY=0.6
SIMULATOR_DRIFT=0.05

# --- Simulated execution liquidity ---
LIQUIDITY_LEVELS=5
LIQUIDITY_HALF_SPREAD_BPS=10
LIQUIDITY_LEVEL_STEP_BPS=10
LIQUIDITY_LEVEL_NOTIONAL_USD=25000

# --- Trading rules ---
MIN_ORDER_NOTIONAL_USD=1
MAX_ORDER_QUANTITY=1000000

# --- Circuit breaker ---
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_THRESHOLD=0.15
CIRCUIT_BREAKER_HALT_SECONDS=30
